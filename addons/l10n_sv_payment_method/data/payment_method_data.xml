<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Formas de Pago según catálogo CAT_021_Forma_Pago del Ministerio de Hacienda -->
        
        <!-- 01 - Contado -->
        <record id="payment_method_contado" model="l10n_sv.payment.method">
            <field name="name">Contado</field>
            <field name="code">01</field>
            <field name="sequence">10</field>
            <field name="description">Pago realizado en el momento de la venta o prestación del servicio</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 02 - Crédito -->
        <record id="payment_method_credito" model="l10n_sv.payment.method">
            <field name="name">Crédito</field>
            <field name="code">02</field>
            <field name="sequence">20</field>
            <field name="description">Pago diferido en el tiempo, total o parcialmente</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 03 - Mixto -->
        <record id="payment_method_mixto" model="l10n_sv.payment.method">
            <field name="name">Mixto</field>
            <field name="code">03</field>
            <field name="sequence">30</field>
            <field name="description">Combinación de pago al contado y a crédito</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
